{
  "boot-source": {
    "kernel_image_path": "/ext2/firecracker-vmlinux",
    "initrd_path": "/ext2/initramfs.cpio.gz",
    "boot_args": "console=ttyS0 reboot=k panic=1 acpi=ht pci=off init=/init root=/dev/vda rw"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/ext2/rootfs.img",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "06:00:ac:10:00:02",
      "host_dev_name": "tap0"
    }
  ],
  "machine-config": {
    "vcpu_count": 4,
    "mem_size_mib": 256,
    "smt": false
  }
}
